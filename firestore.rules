rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function mine(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  function member(cid) { return signedIn() && exists(/databases/$(database)/documents/conversations/$(cid)) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members; }
  match /users/{uid} {
   allow get, list: if signedIn();
   allow update: if mine(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','photoURL','coverURL'])
     && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
     && request.resource.data.bio is string && request.resource.data.bio.size() <= 500;
   allow create, delete: if false;
  }
  match /posts/{id} {
   allow get, list: if signedIn() && (resource.data.visibility == 'public' || resource.data.authorId == request.auth.uid);
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['authorId','body','imageURLs','visibility','createdAt','updatedAt'])
     && request.resource.data.keys().hasAll(['authorId','body','imageURLs','visibility','createdAt','updatedAt'])
     && request.resource.data.authorId == request.auth.uid && request.resource.data.body is string
     && request.resource.data.body.size() <= 2000 && request.resource.data.body.size() > 0
     && request.resource.data.imageURLs is list && request.resource.data.imageURLs.size() <= 4
     && request.resource.data.visibility in ['public','private']
     && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
   allow update: if mine(resource.data.authorId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt'])
     && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
     && request.resource.data.updatedAt == request.time;
   allow delete: if mine(resource.data.authorId) || admin();
   match /comments/{commentId} {
    allow read: if signedIn() && get(/databases/$(database)/documents/posts/$(id)).data.visibility == 'public';
    allow create: if signedIn() && request.resource.data.keys().hasOnly(['authorId','body','createdAt'])
      && request.resource.data.authorId == request.auth.uid && request.resource.data.body is string
      && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
      && request.resource.data.createdAt == request.time
      && get(/databases/$(database)/documents/posts/$(id)).data.visibility == 'public';
    allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin());
    allow update: if false;
   }
   match /likes/{uid} { allow read: if signedIn(); allow write: if false; }
  }
  match /follows/{id} { allow read: if signedIn(); allow write: if false; }
  match /communities/{id} {
   allow read: if signedIn() && resource.data.visibility == 'public';
   allow write: if false;
   match /members/{uid} { allow read: if signedIn() && get(/databases/$(database)/documents/communities/$(id)).data.visibility == 'public'; allow write: if false; }
  }
  match /events/{id} {
   allow read: if signedIn() && resource.data.status == 'active';
   allow write: if false;
   match /attendees/{uid} { allow read: if signedIn(); allow write: if false; }
  }
  match /conversations/{id} {
   allow get, list: if signedIn() && request.auth.uid in resource.data.members;
   allow write: if false;
   match /messages/{mid} {
    allow read: if member(id);
    allow write: if false;
   }
  }
  match /reports/{id} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
