{
  "name": "ralli-social",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run tests/finance.test.ts",
    "test:rules": "firebase emulators:exec --project demo-ralli --only firestore,storage 'vitest run tests/rules.test.ts'",
    "test:e2e": "playwright test",
    "deploy:backend": "firebase deploy --only firestore,storage,functions",
    "deploy:frontend": "vercel --prod"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/vercel": "11.0.13",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
