---
import Base from '../layouts/Base.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';
export const prerender=true;
const pages:Record<string,{eyebrow:string;title:string;intro:string;sections:[string,string][]}>= {
 'fonctionnalites':{eyebrow:'UNE PLACE POUR VOS IDÉES',title:'Tout commence par un lien.',intro:'Publiez, découvrez, échangez et donnez une suite réelle à vos conversations.',sections:[['Fil de découverte','Retrouvez les publications publiques les plus récentes. La première version utilise l’ordre chronologique.'],['Conversations','Écrivez directement à un membre. Les échanges sont réservés aux participants connectés.'],['Rencontres','Créez un événement et accueillez ses premiers participants.']]},
 'communautes':{eyebrow:'SE RASSEMBLER',title:'Votre cercle prend forme.',intro:'Créez un espace public autour d’un intérêt commun et invitez les personnes qui partagent cet élan.',sections:[['Créer','Choisissez un nom et une description pour lancer votre communauté.'],['Participer','Rejoignez une communauté et rencontrez ses membres.'],['Évoluer','Les outils avancés de modération et de personnalisation sont prévus pour une version ultérieure.']]},
 'createurs':{eyebrow:'PRENDRE LA PAROLE',title:'Vos idées méritent un public.',intro:'Partagez votre travail, créez des échanges et trouvez des personnes qui s’y reconnaissent.',sections:[['Publier','Texte et images, directement dans votre espace.'],['Échanger','Commentaires et réactions enregistrés dans votre compte.'],['Grandir','Les offres Creator seront proposées lorsque les paiements seront opérationnels.']]},
 'entreprises':{eyebrow:'POUR LES ORGANISATEURS',title:'Rassemblez autour de ce que vous construisez.',intro:'Créez des communautés et des événements pour réunir votre public.',sections:[['Communautés','Donnez une place à vos membres.'],['Événements','Gérez les inscriptions et la capacité de vos événements.'],['Offre professionnelle','Les campagnes payantes et l’analytique professionnelle demandent encore leur intégration commerciale.']]},
 'tarifs':{eyebrow:'TARIFS ENVISAGÉS',title:'Un point de départ pour chaque ambition.',intro:'Ces tarifs sont des hypothèses. Les abonnements payants ne sont pas encore disponibles à l’achat.',sections:[['Free — 0 $','Publications, communautés publiques et événements.'],['Creator — 9 $ / mois','Outils avancés proposés pour une prochaine étape, sous réserve du lancement des paiements.'],['Community Pro — 49 $ / mois','Gestion avancée des communautés, à développer.'],['Business — 199 $ / mois','Outils professionnels et campagnes, à développer.']]},
 'a-propos':{eyebrow:'NOTRE INTENTION',title:'Un réseau qui mène quelque part.',intro:'Ralli est un projet provisoire de plateforme sociale centré sur les communautés et les rencontres.',sections:[['Pourquoi','Les passions partagées prennent plus de valeur lorsqu’elles deviennent des relations concrètes.'],['Où en sommes-nous ?','Le socle social initial est en cours de validation. Les offres commerciales ne sont pas ouvertes.']]},
 'contact':{eyebrow:'NOUS CONTACTER',title:'Parlons de la suite.',intro:'Les coordonnées de l’exploitant seront publiées avant le lancement. Aucun formulaire de contact n’est activé sans service de réception.',sections:[['Pour le moment','Utilisez les outils de signalement dans l’application pour les contenus publiés.']]},
 'aide':{eyebrow:'CENTRE D’AIDE',title:'Vous êtes au bon endroit.',intro:'Quelques réponses pour prendre vos marques.',sections:[['Créer un compte','Choisissez une adresse électronique et un mot de passe, ou connectez-vous avec Google.'],['Rejoindre une communauté','Ouvrez l’onglet Communautés dans l’application et sélectionnez Rejoindre.'],['Signaler un contenu','Utilisez Signaler sur une publication et décrivez le problème.']]},
 'faq':{eyebrow:'QUESTIONS FRÉQUENTES',title:'Les réponses essentielles.',intro:'Ce que vous devez savoir pour commencer.',sections:[['Ralli est-il gratuit ?','Oui, le compte et les fonctions sociales initiales sont gratuits.'],['Peut-on payer un abonnement ?','Non. Les offres payantes sont des hypothèses tant que leur intégration de paiement n’est pas validée.'],['Mes messages sont-ils chiffrés de bout en bout ?','Non. Les conversations sont soumises à des règles d’accès, sans chiffrement de bout en bout.']]},
 'confidentialite':{eyebrow:'PROJET À VALIDER',title:'Vos données, clairement.',intro:'Ce texte est un projet d’information. Il doit être adapté à l’exploitant et validé juridiquement avant le lancement.',sections:[['Données traitées','Compte, profil, publications, interactions, inscriptions et messages sont hébergés dans les services Firebase configurés par l’exploitant.'],['Finalités','Fournir les fonctions sociales et protéger les utilisateurs contre les abus.'],['Durées et droits','Une politique de conservation et les procédures d’accès, d’exportation et d’effacement doivent être finalisées avant ouverture au public.']]},
 'conditions':{eyebrow:'PROJET À VALIDER',title:'Un espace partagé, des règles communes.',intro:'Projet de conditions à faire compléter et valider avant mise en production.',sections:[['Utilisation','Respectez les autres membres, leurs droits et les lois applicables.'],['Contenu','N’envoyez pas de contenus illicites ou portant atteinte à autrui.'],['Modération','Les procédures de suspension, recours et retrait doivent être finalisées avant le lancement public.']]},
 'publicite':{eyebrow:'PUBLICITÉ',title:'Une promotion toujours identifiable.',intro:'Aucune publicité automatisée ou campagne directe n’est activée dans ce socle.',sections:[['À l’avenir','Toute publication sponsorisée devra être clairement indiquée et approuvée.'],['Consentement','Les emplacements non essentiels ne seront activés qu’après mise en place des choix requis.']]},
 'cookies':{eyebrow:'VOS CHOIX',title:'Le strict nécessaire.',intro:'La session sécurisée utilise des cookies nécessaires au fonctionnement du compte.',sections:[['Cookies nécessaires','Un cookie HttpOnly pour la session et un jeton CSRF pour les formulaires sensibles.'],['Mesure et publicité','Aucun cookie publicitaire n’est activé dans ce socle. Les préférences seront proposées avant toute activation.']]},
 'signalement':{eyebrow:'PROTECTION',title:'Un signalement compte.',intro:'Depuis une publication, l’action Signaler envoie un motif à la file de traitement.',sections:[['Contenu abusif','Décrivez le problème depuis la publication concernée.'],['Urgence','Les contacts et procédures d’escalade seront publiés par l’exploitant avant ouverture.']]},
 'accessibilite':{eyebrow:'ACCESSIBILITÉ',title:'Un espace pour chacun.',intro:'Nous concevons les interfaces pour l’usage au clavier, sur mobile et avec les technologies d’assistance.',sections:[['Vos préférences','Les animations se réduisent si le système demande moins de mouvement.'],['Amélioration','Un audit WCAG complet et un canal de retour doivent être organisés avant lancement public.']]}
};
export function getStaticPaths(){return ['fonctionnalites','communautes','createurs','entreprises','tarifs','a-propos','contact','aide','faq','confidentialite','conditions','publicite','cookies','signalement','accessibilite'].map(slug=>({params:{slug}}))}
const page=pages[Astro.params.slug??''];
if(!page)return Astro.redirect('/404');
---
<Base title={`${page.title} — Ralli`} description={page.intro}><Header/><main id="content" class="content-page"><span class="eyebrow">{page.eyebrow}</span><h1>{page.title}</h1><p class="lead">{page.intro}</p><div class="content-sections">{page.sections.map(([title,copy])=><section><h2>{title}</h2><p>{copy}</p></section>)}</div><a class="button primary" href="/inscription">Découvrir Ralli ↗</a></main><Footer/></Base>
